.ONESHELL:
.SHELLFLAGS += -e

PWD := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
ASSETS := $(PWD)/assets
ROOT := /tmp/practice
GITHUB := https://github.com/yoursdearboy/practice.git

define keep
	echo $(1) >> $(ROOT)/.step
endef

define check
	if grep -q $(1) $(ROOT)/.step; then
		exit
	fi
endef

USER1 := $(ROOT)/user1
USER2 := $(ROOT)/user2
USER3 := $(ROOT)/user3
USER4 := $(ROOT)/user4


step0:
	$(call check,step0)

	mkdir -p $(ROOT)

	$(call keep,step0)

# Создаем проект
# TODO: как назвать проект? пока project, надо automatization
step1: step0
	$(call check,step1)

	unzip assets/01-project.zip -d $(ROOT)

	$(call keep,step1)

# Создаем коммит
step2: step1
	$(call check,step2)

	cd $(user1)
	git add .
	git commit -m "Создали проект R"

	$(call keep,step2)

# Пуш
step3: step2
	$(call check,step3)

	cd $(user1)
	git remote add origin $(GITHUB)
	git branch -M main
	git push -u --force origin main

	$(call keep,step3)

# Все клонируют (кроме ведущего)
step4: step3
	$(call check,step4)

	git clone $(GITHUB) $(user2)
	git clone $(GITHUB) $(user3)
	git clone $(GITHUB) $(user4)

	$(call keep,step4)

# Добавляем данные
# TODO: Учесть практику с проекта и скопировать в data/___
step5: step4
	$(call check,step5)

	cd $(user1)
	mkdir -p data/raw
	cp $(ASSETS)/data/raw/data.csv data/raw/
# 	git add .
# 	git commit -m "Загрузили данные"

clean:
	rm -fr $(ROOT)
